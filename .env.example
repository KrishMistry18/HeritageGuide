# ============================================================
# HeritageGuide — Environment Variables
# Copy this file to .env and fill in your values
# ============================================================

# ── Django Core ──────────────────────────────────────────────
# Generate a strong secret key: python -c "from django.core.management.utils import get_random_secret_key; print(get_random_secret_key())"
SECRET_KEY=your-very-long-random-secret-key-here

# Set to False in production
DEBUG=False

# Comma-separated list of allowed hosts
# For Vercel: your-project.vercel.app,your-custom-domain.com
ALLOWED_HOSTS=127.0.0.1,localhost,your-project.vercel.app

# ── Database ─────────────────────────────────────────────────
# Leave empty to use SQLite (local dev only)
# For production use Supabase Postgres:
# postgresql://postgres:[PASSWORD]@db.[PROJECT-REF].supabase.co:5432/postgres
DATABASE_URL=

# ── Google OAuth (django-allauth) ────────────────────────────
# Create credentials at: https://console.cloud.google.com/
# Authorized redirect URI: https://your-domain.com/accounts/google/login/callback/
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# ── Google Maps ──────────────────────────────────────────────
# Get key at: https://developers.google.com/maps/documentation/javascript/get-api-key
GOOGLE_MAPS_API_KEY=

# ── AI Features ──────────────────────────────────────────────
# OpenAI (optional)
OPENAI_API_KEY=

# Anthropic Claude — powers the Roamly AI chatbot
ANTHROPIC_API_KEY=

# ── Supabase (optional — for cloud storage & auth sync) ──────
SUPABASE_URL=https://your-project-ref.supabase.co
SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=
