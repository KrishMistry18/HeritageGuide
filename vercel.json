{
  "version": 2,
  "builds": [
    {
      "src": "historify/wsgi.py",
      "use": "@vercel/python",
      "config": {
        "maxLambdaSize": "15mb",
        "runtime": "python3.12"
      }
    }
  ],
  "routes": [
    {
      "src": "/static/(.*)",
      "dest": "/static/$1"
    },
    {
      "src": "/(.*)",
      "dest": "historify/wsgi.py"
    }
  ],
  "buildCommand": "pip install -r requirements.txt --break-system-packages && python manage.py collectstatic --noinput && python manage.py migrate --noinput"
}
